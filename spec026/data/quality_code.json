    "id": "S026Q/palindrome",
    "prompt": "Write Python function solve(s). Ignore nonletters and case, and return whether the resulting letters form a palindrome. Return only the function, without imports or explanations.",
    "solution": "def solve(s):\n    s=\"\".join(c.lower() for c in s if c.isalpha())\n    return s==s[::-1]\n",
    "cases": [
      {
        "args": [
          ""
        ],
        "expected": true
      },
      {
        "args": [
          "A"
        ],
        "expected": true
      },
      {
        "args": [
          "abba"
        ],
        "expected": true
      },
      {
        "args": [
          "abc"
        ],
        "expected": false
      },
      {
        "args": [
          "A man, a plan, a canal: Panama!"
        ],
        "expected": true
      },
      {
        "args": [
          "12"
        ],
        "expected": true
      }
    ]
