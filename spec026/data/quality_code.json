  {
    "id": "S026Q/interleave",
    "prompt": "Write Python function solve(pair). pair contains lists a and b. Interleave a[0],b[0],a[1],b[1],... and append any remaining tail. Return only the function, without imports or explanations.",
    "solution": "def solve(pair):\n    a,b=pair\n    out=[]\n    for i in range(max(len(a),len(b))):\n        if i<len(a):out.append(a[i])\n        if i<len(b):out.append(b[i])\n    return out\n",
    "cases": [
